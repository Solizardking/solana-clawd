{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/agent-card.json",
      "destination": "https://cheshire-clawd-terminal.fly.dev/.well-known/agent-card.json"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "https://cheshire-clawd-terminal.fly.dev/.well-known/mcp"
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "destination": "https://cheshire-clawd-terminal.fly.dev/.well-known/mcp/server-card.json"
    },
    {
      "source": "/api/helius/verify-clawd",
      "destination": "https://ardent-bee-499.convex.site/api/helius/verify-clawd"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "https://cheshire-clawd-terminal.fly.dev/.well-known/$1"
    },
    {
      "source": "/mcp",
      "destination": "https://cheshire-clawd-terminal.fly.dev/mcp"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://cheshire-clawd-terminal.fly.dev/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
