{
  "name": "@pump-fun/mcp-server",
  "version": "1.0.0",
  "description": "Solana Clawd MCP server for the Pump SDK: 55 tools for token creation, trading, fees, analytics, AMM, incentives, and wallet workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pump-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.9.7",
    "@nirholas/pump-sdk": "^1.30.0",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
