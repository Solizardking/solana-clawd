[Unit]
Description=clawd-pump 24/7 trading agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/Users/8bit/Downloads/solana-clawd/clawd-pump
Environment=RUST_LOG=info
Environment=LOG_DIR=/Users/8bit/Downloads/solana-clawd/clawd-pump/logs
ExecStart=/Users/8bit/Downloads/solana-clawd/clawd-pump/scripts/run_24_7.sh copy
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

# Run under the operator account that owns the hot wallet and repo checkout.
User=REPLACE_WITH_OPERATOR_USER
Group=REPLACE_WITH_OPERATOR_GROUP

# Hardening. Keep writable paths limited to the repo because logs and target may be updated.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/Users/8bit/Downloads/solana-clawd/clawd-pump

[Install]
WantedBy=multi-user.target
