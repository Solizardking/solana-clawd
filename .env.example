# OpenClawd Configuration
# Copy to .env and fill in your keys

# === AI Providers ===
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL1=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL2=nvidia/nemotron-3.5-content-safety:free
OPENROUTER_MODEL3=openrouter/optimus-alpha:free

# Google Gemini API (get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Google Search grounding (uses same GEMINI_API_KEY)

# xAI
XAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# === Solana ===
HELIUS_API_KEY=
SOLANA_PRIVATE_KEY=
RPC_URL=

# === Clawd Agent Auth (CAAP/1.0) ===
# CLAWD_AUTH_BASE_URL=https://x402.wtf/api/auth
# CLAWD_AGENT_KEYPAIR=base58-encoded-ed25519-keypair

# === Natural Language Trading (gateway) ===
# Honcho memory layer — get app id at https://app.honcho.dev
HONCHO_APP_ID=solana-clawd
HONCHO_API_KEY=

# Model for NL intent classification (default: claude-haiku-4-5-20251001)
CLAWD_NL_MODEL=claude-haiku-4-5-20251001

# Path to clawd-pump dir (auto-detected if in monorepo)
PUMP_DIR=./clawd-pump
# Set to "true" to disable actual trade execution (safe testing)
PUMP_DRY_RUN=false