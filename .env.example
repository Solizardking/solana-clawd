# OpenClawd / Leviathan configuration
# Copy this file to `.env`. Never commit the real file.

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL1=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL2=nvidia/nemotron-3.5-content-safety:free
OPENROUTER_MODEL3=openrouter/optimus-alpha:free

# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional secondary providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.3
GROK_IMAGE_MODEL=grok-imagine-image-quality
GROK_VIDEO_MODEL=grok-imagine-video
GROK_VOICE_ID=eve
PERPLEXITY_API_KEY=

# DeepSeek autonomous arena / agent backend
# Keep this server-side only. Do not expose it through VITE_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# Optional Claude Code / Anthropic-compatible bridge via DeepSeek.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=<your DeepSeek API key>
# ANTHROPIC_MODEL=deepseek-v4-pro[1m]
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
# CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
# CLAUDE_CODE_EFFORT_LEVEL=max

# -----------------------------------------------------------------------------
# Solana / runtime
# -----------------------------------------------------------------------------
HELIUS_API_KEY=
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_DEVNET_URL=https://devnet.helius-rpc.com/?api-key=your-helius-api-key
SOLANA_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=your-helius-api-key
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
CREATOR_PUBKEY=
VAULT_PASSPHRASE=

# -----------------------------------------------------------------------------
# x402 payments
# -----------------------------------------------------------------------------
X402_ENABLED=false
X402_NETWORK=solana-mainnet
X402_SVM_PRIVATE_KEY=
X402_SVM_PUBLIC_KEY=
X402_FACILITATOR_URL=https://clawdrouter.fly.dev
X402_MAX_PER_REQUEST=0.10
X402_MAX_SESSION=1.00

# -----------------------------------------------------------------------------
# CAAP / agent auth
# -----------------------------------------------------------------------------
# CLAWD_AUTH_BASE_URL=https://x402.wtf/api/auth
# CLAWD_AGENT_KEYPAIR=base58-encoded-ed25519-keypair

# -----------------------------------------------------------------------------
# Gateway / natural-language trading
# -----------------------------------------------------------------------------
HONCHO_APP_ID=solana-clawd
HONCHO_API_KEY=
CLAWD_NL_MODEL=claude-haiku-4-5-20251001
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Neon Auth + Data API install tracking
# -----------------------------------------------------------------------------
# Server-side only. Do not put raw Postgres connection strings in public docs.
NEON_AUTH_URL=
NEON_AUTH_JWKS=
NEON_AUTH_AUDIENCE=
NEON_DATA_API_URL=
NEON_DATA_API_KEY=
NEON_ID=
NEON_TRACKING_TABLE=agent_install_events
NEON_TRACKING_TOKEN=

# Optional client/installer telemetry endpoint. Defaults to the public gateway.
CLAWD_TRACKING_URL=https://x402.wtf/api/track/install
CLAWD_TRACKING_TOKEN=
CLAWD_DISABLE_TRACKING=false

# Path to clawd-pump dir (auto-detected if in monorepo)
PUMP_DIR=./clawd-pump
PUMP_DRY_RUN=false
