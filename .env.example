# ── Solana Clawd (Leviathan Runtime) — environment template ──────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# ── AI providers (pick at least one) ─────────────────────────────────────────
XAI_API_KEY=                        # xAI / Grok — x.ai/api
OPENROUTER_API_KEY=                 # OpenRouter (Claude, Llama, etc.) — openrouter.ai
ANTHROPIC_API_KEY=                  # Anthropic direct — console.anthropic.com
OPENROUTER_MODEL1=anthropic/claude-sonnet-4-6

# ── Solana ────────────────────────────────────────────────────────────────────
CREATOR_PUBKEY=                     # Your Solana public key (for agent minting)
SOLANA_RPC_URL=                     # e.g. https://mainnet.helius-rpc.com/?api-key=...
SOLANA_PRIVATE_KEY=                 # base58 keypair (on-chain ops only, optional)
HELIUS_API_KEY=                     # Free at helius.dev — better RPC + WebSocket

# ── x402 micropayments ────────────────────────────────────────────────────────
X402_SVM_PRIVATE_KEY=               # base58 keypair for USDC payments
X402_NETWORK=solana-mainnet         # solana-mainnet | solana-devnet
X402_MAX_PER_REQUEST=0.10           # max $ per auto-pay (default 10¢)
X402_MAX_SESSION=1.00               # session spend cap (default $1)

# ── Leviathan runtime ─────────────────────────────────────────────────────────
LEVIATHAN_NAME=                     # agent display name
CLAWD_MAX_STEPS=32
CLAWD_MAX_COST_USD=1

# ── OpenRouter free-model gacha ───────────────────────────────────────────────
# Get a free key at openrouter.ai — works with free models instantly
OPENROUTER_API_KEY=
# Slot 1: heavy reasoning  (free)
OPENROUTER_MODEL1=nvidia/nemotron-3-ultra-550b-a55b:free
# Slot 2: safety / content filter  (free)
OPENROUTER_MODEL2=nvidia/nemotron-3.5-content-safety:free
# Slot 3: auto / general  (free)
OPENROUTER_MODEL3=openrouter/optimus-alpha:free

# ── Optional services ─────────────────────────────────────────────────────────
RESEARCH_API_URL=http://localhost:8000
ORCHESTRATOR_URL=http://localhost:8787
SOLANA_TRACKER_API_KEY=
