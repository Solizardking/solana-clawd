    "./src/molting/spawn.ts",
    "./src/survival/monitor.ts",
    "./src/agent/system-prompt.ts",
    "./src/types/index.ts",
    "./src/state/app-state.ts",
    "./src/helius/index.ts",
    "./src/services/x402/index.ts",
    "./src/services/x402/types.ts",
    "./src/buddy/index.ts",
    "./src/gacha/index.ts",
