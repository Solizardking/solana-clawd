    "attest:redpill:devnet": "tsx scripts/attest-redpill-devnet.ts",
    "dbc:create-config": "tsx scripts/create-dbc-config.ts",
    "db:push": "drizzle-kit push",
    "import:browser-agents": "node scripts/import-browser-agents.mjs",
    "update-env": "node scripts/update-vercel-helius.mjs",
    "postinstall": "node -e \"import('node:fs').then(({existsSync}) => existsSync('scripts/patch-noble-hashes.mjs') ? import('./scripts/patch-noble-hashes.mjs') : console.log('[postinstall] scripts/patch-noble-hashes.mjs not uploaded; skipping'))\""
