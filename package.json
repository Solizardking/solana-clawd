  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/lib/pump/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/pump/index.js && esbuild server/lib/clawd/pump-executor.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/clawd/pump-executor.js && esbuild server/vercel.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/vercel-api.js",
    "start": "NODE_ENV=production node dist/index.js",
    "deploy": "vercel --archive=tgz",
    "deploy:vercel": "vercel deploy --prod --yes --archive=tgz",
    "arena:install": "bash arena/install.sh",
    "audit:open-source": "node scripts/audit-open-source.mjs",
    "register:google-agent": "bash scripts/google-cloud/register-agent-registry.sh",
    "check": "tsc",
    "browser-run:dev": "pnpm --dir workers/browser-run dev",
    "browser-run:deploy": "pnpm --dir workers/browser-run deploy",
    "browser-run:typecheck": "pnpm --dir workers/browser-run typecheck",
    "smoke:routes": "node scripts/audit-routes-nav.mjs",
    "smoke:telegram-routes": "node scripts/audit-telegram-routes.mjs",
    "smoke:remote-links": "node scripts/audit-remote-links.mjs",
    "smoke:mobile-surface": "node scripts/audit-mobile-surface.mjs",
    "smoke:mobile-render": "node scripts/smoke-mobile-render.mjs",
    "smoke:api-coverage": "node scripts/audit-api-smoke-coverage.mjs",
    "smoke:cloudflare-stream": "node scripts/smoke-cloudflare-stream.mjs",
    "smoke:components": "node scripts/audit-component-surface.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "smoke:http": "npm run smoke:pages",
    "smoke:surface": "npm run smoke:routes && npm run smoke:telegram-routes && npm run smoke:remote-links && npm run smoke:mobile-surface && npm run smoke:api-coverage && npm run smoke:components",
    "smoke:all": "npm run smoke:surface && npm run smoke:pages",
    "check:upstash": "node scripts/check-upstash.mjs",
    "check:api": "node scripts/check-api-readiness.mjs",
    "smoke:api-key": "node scripts/smoke-api-key-lifecycle.mjs",
    "smoke:clerk": "node scripts/smoke-clerk-auth.mjs",
