{
  "name": "@openclawd/lobster-library",
  "version": "2.0.0",
  "description": "🦞 Solana Clawd agent fleet for trading, research, x402 payments, OpenClawd orchestration, and machine-native finance on Solana. Hosted at https://x402.wtf/library",
  "homepage": "https://x402.wtf/library",
  "repository": {
    "type": "git",
    "url": "https://github.com/Solizardking/solana-clawd.git",
    "directory": "library"
  },
  "bugs": {
    "url": "https://github.com/Solizardking/solana-clawd/issues"
  },
  "license": "MIT",
  "author": "x402agent",
  "type": "module",
  "main": "public/index.json",
  "exports": {
    ".": "./public/index.json",
    "./index.json": "./public/index.json",
    "./meta.json": "./public/meta.json",
    "./schema": "./schema/speraxAgentSchema_v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "public",
    "schema",
    "src",
    "scripts",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "awesome": "bun scripts/commands/build.ts && bun scripts/commands/update-awesome.ts",
    "build": "node ../../scripts/sync-library.mjs",
    "format": "bun scripts/commands/format.ts",
    "generate": "node scripts/generate-lobster-agents.mjs",
    "i18n:clean": "bun scripts/commands/validate-language.ts --delete",
    "i18n:fix": "bun scripts/commands/validate-language.ts --fix",
    "i18n:validate": "bun scripts/commands/validate-language.ts",
    "lint": "eslint \"scripts/**/*.ts\" --fix",
    "lint:i18n": "bun scripts/commands/validate-language.ts",
    "lint:md": "remark . --quiet --output",
    "prettier": "prettier -c --write \"**/*.{json,ts,md}\"",
    "release": "semantic-release",
    "submit": "bun scripts/commands/auto-submit.ts",
    "sync": "node ../../scripts/sync-library.mjs",
    "test": "bun scripts/commands/test.ts",
    "test:locale": "bun scripts/commands/test-locale.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@lobehub/lint": "^1.25.5",
    "@octokit/rest": "^20.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.17.16",
    "@yutengjing/eld": "^0.0.2",
    "consola": "^3.4.0",
    "dayjs": "^1.11.13",
    "dirty-json": "^0.9.2",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "fs-extra": "^11.3.0",
    "gpt-tokenizer": "^3.0.0",
    "lodash-es": "^4.17.21",
    "openai": "^5.1.1",
    "pangu": "^4.0.7",
    "p-map": "^7.0.3",
    "prettier": "^3.4.2",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^21.1.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "solana",
    "defi",
    "trading",
    "ai-agents",
    "machine-learning",
    "prediction-market",
    "perpetuals",
    "mev",
    "quantitative-trading",
    "whale-tracking",
    "on-chain-analytics",
    "lobster-library",
    "x402",
    "openclawd",
    "clawd",
    "solana-pay",
    "x402.wtf",
    "agent-fleet",
    "nano-agent",
    "agent-catalog"
  ]
}
