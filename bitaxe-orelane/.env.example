# Solana RPC (required — use Helius or another RPC provider)
RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# HELIUS_RPC_URL is an alias for RPC
HELIUS_API_KEY=YOUR_HELIUS_KEY

# Keypair (one of these is required for live execution)
KEYPAIR=/path/to/solana-keypair.json
# KEYPAIR_BASE58=your-base58-private-key

# Bitaxe
BITAXE_URL=http://192.168.1.100/

# ORE
X402_ORE_URL=https://x402.wtf/ore
ORE_ROOT=/path/to/ore-master

# Safety gates (all must be explicitly set to enable live execution)
DRY_RUN=true
LIVE_EXECUTION=false
OPERATOR_CONFIRMED=false
RIG_CONTROL_LIVE=false

# Policy
MAX_DEPLOY_SOL=0.05
MIN_RESERVE_SOL=0.05
MAX_SQUARES_PER_ROUND=3
CLAIM_SOL_THRESHOLD=0.01
CLAIM_ORE_THRESHOLD=0.5
REQUIRE_HEALTHY_BITAXE=true
BITAXE_MAX_TEMP_C=72
BITAXE_MAX_CPU=75
BITAXE_MIN_FREE_HEAP=150000
BITAXE_MIN_RSSI=-75

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# LLM routing (optional — falls back to keyword routing if not set)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Phoenix perps via Vulcan (optional)
VULCAN_BIN=vulcan
VULCAN_WALLET_NAME=
VULCAN_WALLET_PASSWORD=
LIVE_TRADING=false
PERPS_SIM_ONLY=true
CLAWD_PERPS_CLI_PATH=
CLAWD_PERPS_PROJECT_ROOT=

# x402 payments (optional)
X402_PAYMENT_URL=https://x402.wtf/ore
PAYMENTS_LIVE=false

# Dashboard
ORELANE_DASHBOARD_URL=https://x402.wtf/ore

# Loop tick interval (ms)
TICK_INTERVAL_MS=60000
