{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/index.css",
    "src/vulcan-cli-master/**",
    "src/tailclawd/**",
    "src/shims/**",
    "src/upstreamproxy/**",
    "src/telegram/**",
    "src/voice/**"
  ]
}