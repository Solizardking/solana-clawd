# ─── GitHub App ──────────────────────────────────────────────────────────────
# Your GitHub App ID (found in App settings)
GITHUB_APP_ID=

# GitHub App private key — paste the full PEM, newlines as \n
# Generate at: Settings > Developer settings > GitHub Apps > Your App > Private keys
GITHUB_APP_PRIVATE_KEY=

# Webhook secret — set this when creating your GitHub App
GITHUB_WEBHOOK_SECRET=

# ─── AI Backend ──────────────────────────────────────────────────────────────
# xAI (Grok) API key — get at https://console.x.ai/
XAI_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of branches to scan on direct push (default: main,master,develop)
PROTECTED_BRANCHES=main,master,develop
