  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solizardking/solanaclawd.git",
    "directory": "packages/agent-hub"
  },
  "homepage": "https://solanaclawd.com",
  "files": ["dist", "public"],
  "dependencies": {
    "@openclawdsolana/agent-registry": "^2.0.0",
    "@noble/hashes": "~1.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ora": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
