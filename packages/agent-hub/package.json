{
  "name": "@openclawdsolana/agent-hub",
  "version": "2.0.0",
  "description": "Solana Clawd Agent Hub — local discovery server and dashboard for Solana AI agents (the LM Studio of Solana agents)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clawd-hub": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solana",
    "agent-hub",
    "metaplex",
    "ai-agents",
    "solanaclawd",
    "dashboard",
    "discovery"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
