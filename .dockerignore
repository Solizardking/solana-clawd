# Docker/Fly build context guard.
#
# Docker does not read .gitignore. Keep local secrets, private state, generated
# artifacts, and bulky workspaces out of remote build contexts by default.

# Git and local project state
.git/
.gitmodules
.github/
.claude/
.clawd/
.codex/
.cursor/
.grok/
.solana/
.vscode/
.idea/
.vercel/
**/.vercel/
.playwright-mcp/

# Environment and credentials
.env
.env.*
!.env.example
!**/.env.example
!.env.template
!**/.env.template
!.env.sample
!**/.env.sample
config.env
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.asc
*.gpg
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.ppk
wallet.json
*-wallet.json
agent-wallet.json
keypair.json
*-keypair.json
*_keypair.json
keypair*.json
id.json
credentials.json
service-account*.json
gcp-credentials*.json
google-credentials*.json
firebase-adminsdk*.json
aws-credentials
google-services.json
*.b58
*.b64.key

# Runtime sessions and local databases
.agent-sessions/
.clawdbot/
.imperial/
.paper/
.perps/
.vulcan/
sessions/
vulcan-runs/
paper-state.json
paper-balance.json
agent-memory*.json
session-state*.json
*.session.json
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
.convex/

# Dependencies, builds, caches, and generated artifacts
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.next/
.turbo/
.cache/
coverage/
dist/
**/dist/
dist-web/
build/
out/
outputs/
hf/
