{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@dark-agent/*": ["../dark-agent/*"],
      "@dark-defi/*": ["../dark-defi/*"],
      "@dark-swap/*": ["../dark-swap/*"],
      "@dark-zcash/*": ["../dark-zcash/*"],
      "@dark-helius/*": ["../dark-helius/*"]
    }
  },
  "include": [
    "src",
    "../dark-agent/**/*.ts",
    "../dark-defi/**/*.ts",
    "../dark-swap/**/*.ts",
    "../dark-zcash/**/*.ts",
    "../dark-helius/**/*.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}