# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54323/postgres

# Public URL of this deployment
# BETTER_AUTH_URL is auto-set by portless via PORTLESS_URL
# Only set manually if not using portless:
# BETTER_AUTH_URL=https://directory.localhost

# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# GitHub OAuth (for social sign-in)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Directory admin key for provider management
DIRECTORY_ADMIN_KEY=change-me-in-production

# Host display name shown to providers via MCP
AGENT_AUTH_HOST_NAME=Agent Auth Directory

# Clerk auth for /router-keys and /api/router/*
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ClawdRouter key issuance proxy. Keep the internal secret server-side only.
CLAWDROUTER_PUBLIC_URL=https://clawd-router.fly.dev
NEXT_PUBLIC_CLAWDROUTER_URL=https://clawd-router.fly.dev
CLAWDROUTER_INTERNAL_SECRET=change-me-in-production
ROUTER_WALLET_CHALLENGE_SECRET=change-me-generate-with-openssl-rand-base64-32
