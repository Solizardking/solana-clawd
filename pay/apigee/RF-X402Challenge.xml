<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  pay/apigee/RF-X402Challenge.xml

  Apigee RaiseFault policy: RF-X402Challenge

  Returns a structured HTTP 402 challenge when the buyer has not yet
  paid. The body is the same JSON shape the worker would emit, so any
  client (curl, the storefront lab, the merchant registry) can parse
  it uniformly.

  Attach to the DefaultFaultRule of the TargetEndpoint so that any
  uncaught payment-required condition emits a deterministic 402.
-->
<RaiseFault name="RF-X402Challenge">
  <DisplayName>RF-X402Challenge</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <FaultResponse>
    <Set>
      <Headers>
        <Header name="Content-Type">application/json</Header>
        <Header name="WWW-Authenticate">Payment x402</Header>
        <Header name="X-Solana-Clawd-X402-Store">1</Header>
        <Header name="X-X402-Manifest-Version">2.1</Header>
        <Header name="X-X402-Store-Namespace">openclawd-pay</Header>
        <Header name="X-X402-Store-Challenge-Default">
          /api/x402wtf/checkout?product=pay-quote
        </Header>
      </Headers>
      <StatusCode>402</StatusCode>
      <ReasonPhrase>Payment Required</ReasonPhrase>
      <Payload contentType="application/json">{
        "error": "payment_required",
        "scheme": "x402",
        "merchant": "openclawd-pay",
        "store": "https://x402.wtf",
        "registry": "https://x402.wtf/agents/registry",
        "payments": "https://x402.wtf/payments",
        "amount": {
          "usd": "0.01",
          "atomic": "10000",
          "asset": "USDC"
        },
        "acceptedNetworks": ["base-sepolia", "base", "solana"],
        "challengePath": "/api/x402wtf/checkout?product=pay-quote",
        "products": [
          "pay-quote",
          "agent-chat",
          "pay-attest",
          "agent-registry",
          "registry-register",
          "receipt-verify"
        ],
        "retry": {
          "header": "X-Payment",
          "altHeaders": ["Payment-Receipt", "X-Clawd-Pay-Receipt"]
        },
        "operator": "8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump",
        "feePayer": "8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump",
        "network": "solana-mainnet",
        "manifestVersion": "2.1"
      }</Payload>
    </Set>
  </FaultResponse>
</RaiseFault>
