<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  pay/apigee/AM-SetX402Headers.xml

  Apigee AssignMessage policy: AM-SetX402Headers

  Stamps every paid-store response with the canonical x402 + x402.wtf
  headers so the merchant registry, the storefront, and any compliant
  buyer can introspect the response without parsing JSON.

  Apply on the Response flow of the /v1/solana-clawd-pay proxy, on every
  TargetEndpoint. This is the only policy that mutates the response
  body — it copies the existing JSON and adds the headers in-place.
-->
<AssignMessage name="AM-SetX402Headers">
  <DisplayName>AM-SetX402Headers</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <Set>
    <Headers>
      <Header name="X-Solana-Clawd-Pay">1</Header>
      <Header name="X-Solana-Clawd-X402-Store">1</Header>
      <Header name="X-X402-Manifest-Version">2.1</Header>
      <Header name="X-X402-Store-Namespace">openclawd-pay</Header>
      <Header name="X-X402-Store-Registry">https://x402.wtf/agents/registry</Header>
      <Header name="X-X402-Store-Payments">https://x402.wtf/payments</Header>
      <Header name="X-X402-Store-Operator">8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump</Header>
      <Header name="X-X402-Store-FeePayer">8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump</Header>
      <Header name="X-X402-Store-Network">solana-mainnet</Header>
      <Header name="WWW-Authenticate">Payment x402</Header>
      <Header name="Access-Control-Expose-Headers">
        X-Solana-Clawd-Pay, X-Solana-Clawd-X402-Store, X-X402-Manifest-Version,
        X-X402-Store-Namespace, X-X402-Store-Registry, X-X402-Store-Payments,
        X-X402-Store-Operator, X-X402-Store-FeePayer, X-X402-Store-Network,
        X-Payment, Payment-Receipt, X-Clawd-Product, X-Clawd-Nonce
      </Header>
    </Headers>
  </Set>
  <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
