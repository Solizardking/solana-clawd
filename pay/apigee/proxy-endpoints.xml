<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  pay/apigee/proxy-endpoints.xml

  Apigee ProxyEndpoint bundle: PE-x402wtf-store

  One ProxyEndpoint exposes the whole /api/x402wtf/* surface. The
  flow rules dispatch each path to a dedicated TargetEndpoint in
  target-endpoints.xml. The /api/x402wtf/manifest path is served
  inline (no upstream call) — it just emits the v2.1 manifest.

  Flows:
    1. PreFlow: log + AM-SetX402Headers (request side, captures inbound x402 headers)
    2. Conditional flows dispatch by proxy.pathsuffix
    3. PostFlow: nothing extra (target responses already carry the headers)
    4. DefaultFaultRule: RF-X402Challenge (uniform 402 envelope)
-->
<ProxyEndpoint name="PE-x402wtf-store">
  <Description>OpenClawd Pay — x402.wtf real-store proxy</Description>
  <DefaultFaultRule name="DR-x402wtf-proxy">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>RF-X402Challenge</Name>
    </Step>
  </DefaultFaultRule>

  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-SetX402Headers</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>AM-SetX402Headers</Name>
      </Step>
    </Response>
  </PreFlow>

  <Flows>

    <Flow name="F-info">
      <Description>GET /api/x402wtf/info</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/info"</Condition>
      <Request>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Request>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-info">
        <TargetEndpoint>TE-x402wtf-info</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-registry">
      <Description>GET /api/x402wtf/registry</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/registry"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-registry">
        <TargetEndpoint>TE-x402wtf-registry</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-agents">
      <Description>GET /api/x402wtf/agents</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/agents"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-agents">
        <TargetEndpoint>TE-x402wtf-agents</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-agent-chat">
      <Description>POST /api/x402wtf/agent/chat</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/agent/chat" AND request.verb = "POST"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-agent-chat">
        <TargetEndpoint>TE-x402wtf-agent-chat</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-checkout">
      <Description>POST /api/x402wtf/checkout</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/checkout" AND request.verb = "POST"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-checkout">
        <TargetEndpoint>TE-x402wtf-checkout</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-verify">
      <Description>POST /api/x402wtf/verify</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/verify" AND request.verb = "POST"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-verify">
        <TargetEndpoint>TE-x402wtf-verify</TargetEndpoint>
      </RouteRule>
    </Flow>

    <Flow name="F-register">
      <Description>POST /api/x402wtf/register</Description>
      <Condition>proxy.pathsuffix MatchesPath "/api/x402wtf/register" AND request.verb = "POST"</Condition>
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
      <RouteRule name="RR-register">
        <TargetEndpoint>TE-x402wtf-register</TargetEndpoint>
      </RouteRule>
    </Flow>

  </Flows>

  <HTTPProxyConnection>
    <BasePath>/v1/solana-clawd-pay</BasePath>
    <VirtualHost>apigee.x402.wtf</VirtualHost>
  </HTTPProxyConnection>

  <RouteRule name="RR-default">
    <TargetEndpoint>TE-x402wtf-info</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
