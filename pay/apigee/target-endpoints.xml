    <DefaultFaultRule name="DR-x402wtf-register">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step><Name>RF-X402Challenge</Name></Step>
    </DefaultFaultRule>
  </TargetEndpoint>

</TargetEndpoints>
