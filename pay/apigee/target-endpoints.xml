    <PreFlow name="PreFlow">
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
    </PreFlow>
    <HTTPTargetConnection>
      <URL>https://x402.wtf/agents/registry/agents</URL>
    </HTTPTargetConnection>
    <DefaultFaultRule name="DR-x402wtf-agents">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step><Name>RF-X402Challenge</Name></Step>
    </DefaultFaultRule>
  </TargetEndpoint>

  <!-- ── /api/x402wtf/agent/chat  →  https://x402.wtf/payments/agent/chat -->
  <TargetEndpoint name="TE-x402wtf-agent-chat">
    <PreFlow name="PreFlow">
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
    </PreFlow>
    <HTTPTargetConnection>
      <URL>https://x402.wtf/payments/agent/chat</URL>
    </HTTPTargetConnection>
    <DefaultFaultRule name="DR-x402wtf-agent-chat">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step><Name>RF-X402Challenge</Name></Step>
    </DefaultFaultRule>
  </TargetEndpoint>

  <!-- ── /api/x402wtf/checkout  →  https://x402.wtf/payments/checkout ── -->
  <TargetEndpoint name="TE-x402wtf-checkout">
    <PreFlow name="PreFlow">
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
    </PreFlow>
    <HTTPTargetConnection>
      <URL>https://x402.wtf/payments/checkout</URL>
    </HTTPTargetConnection>
    <DefaultFaultRule name="DR-x402wtf-checkout">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step><Name>RF-X402Challenge</Name></Step>
    </DefaultFaultRule>
  </TargetEndpoint>

  <!-- ── /api/x402wtf/verify  →  https://x402.wtf/payments/verify ────── -->
  <TargetEndpoint name="TE-x402wtf-verify">
    <PreFlow name="PreFlow">
      <Request/>
      <Response>
        <Step><Name>AM-SetX402Headers</Name></Step>
      </Response>
    </PreFlow>
    <HTTPTargetConnection>
      <URL>https://x402.wtf/payments/verify</URL>
    </HTTPTargetConnection>
    <DefaultFaultRule name="DR-x402wtf-verify">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step><Name>RF-X402Challenge</Name></Step>
    </DefaultFaultRule>
  </TargetEndpoint>

  <!-- ── /api/x402wtf/register  →  https://x402.wtf/agents/registry/register -->
