# pay/.env.example
#
# Copy to .env (or pass via `wrangler secret put`) before running
# `npm run launch`. The values shown here are the x402.wtf real-store
# defaults for the OpenClawd Pay merchant. Replace anything marked
# with <replace-me> with your own operator + fee-payer wallet.
#
# ─── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=production

# ─── x402.wtf Real Store Identity ───────────────────────────────────────────
# These six values are what x402.wtf reads from the worker when the
# merchant registry validates our catalog. They MUST match what you
# registered on https://x402.wtf/agents/registry.
X402_STORE_ENABLED=true
X402_STORE_BASE=https://x402.wtf
X402_STORE_NAMESPACE=openclawd-pay
X402_STORE_REGISTRY_URL=https://x402.wtf/agents/registry
X402_STORE_PAYMENTS_URL=https://x402.wtf/payments
X402_MANIFEST_VERSION=2.1

# ─── Pricing (per paid call) ────────────────────────────────────────────────
PRICE_USD=0.01
PRICE_ATOMIC=10000
PAYMENT_ASSET=USDC
PAYMENT_NETWORKS=base-sepolia,base,solana

# ─── Operator + Fee-Payer Wallets (Solana) ──────────────────────────────────
# The operator wallet CONTROLS the merchant registration. It is the pubkey
# that x402.wtf uses to verify who can rotate or de-register products.
# Replace with your own base58 pubkey before going live.
OPERATOR_WALLET_PUBKEY=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump

# The fee-payer wallet PAYS the Solana transaction fees when the worker
# settles an x402 receipt on-chain. It must hold SOL for fees. Generate
# a fresh keypair for this so production secrets never share a wallet
# with the operator or any test agent.
#   solana-keygen new --no-bip39-passphrase -o ~/.config/solana/fee-payer.json
#   solana-keygen pubkey ~/.config/solana/fee-payer.json
FEE_PAYER_WALLET_PUBKEY=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump

# Solana RPC + enforced network. Mainnet by default; switch to
# devnet/testnet while iterating.
PAY_RPC_URL=https://api.mainnet-beta.solana.com
PAY_NETWORK_ENFORCED=solana-mainnet

# ─── Upstream Routing ───────────────────────────────────────────────────────
CLAWDROUTER_URL=http://127.0.0.1:8402
X402_OPENROUTER_URL=http://127.0.0.1:3001
OPENCLAWD_SITE_URL=https://solanaclawd.com
AGENT_REGISTRY_URL=https://solanaclawd.com/api/agents

# ─── MPP / Receipt Verification ─────────────────────────────────────────────
MPP_PROXY_URL=
SOLANA_MPP_ENABLED=false

# ─── Apigee Edge (x402 private edge mirror) ─────────────────────────────────
APIGEE_PROXY_BASE=https://apigee.x402.wtf/v1/solana-clawd-pay
APIGEE_ENV=prod

# ─── Secrets (use `wrangler secret put NAME`) ──────────────────────────────
# OPENROUTER_API_KEY        # optional direct fallback to OpenRouter
# CLAWDROUTER_API_KEY       # optional bearer to ClawdRouter
# MPP_PROXY_TOKEN           # optional shared secret to MPP proxy
# RECEIPT_HMAC_SECRET       # optional HMAC secret for local receipt checks
# PAY_PRIVATE_KEY           # base58 Solana private key for FEE_PAYER_WALLET_PUBKEY
#                           # (NEVER commit; load via `wrangler secret put`)
# X402_STORE_API_KEY        # bearer used to call https://x402.wtf/agents/registry
#                           # (only required if you are writing back to the registry)

# ─── Quick start ───────────────────────────────────────────────────────────
#   cp .env.example .env
#   npm install
#   npm run list         # writes manifest.json and dist/manifest.json
#   npm run launch       # starts wrangler dev on http://127.0.0.1:8787
#   curl http://127.0.0.1:8787/api/x402wtf/manifest | jq .
#
# Production deploy:
#   npx wrangler secret put PAY_PRIVATE_KEY
#   npx wrangler secret put X402_STORE_API_KEY
#   npx wrangler deploy
