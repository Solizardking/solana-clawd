{
  "name": "clawd-cloud-os",
  "version": "2.1.0",
  "description": "OpenClawd cloud terminal surface for SolanaOS, solana-clawd, E2B sandboxes, and operator workflows.",
  "openclawd": {
    "repoRootEnv": "OPENCLAWD_ROOT",
    "preferredLocalSolanaClawdPath": "solana-clawd",
    "fallbackSolanaClawdPath": "~/src/solana-clawd",
    "stateDir": "~/.clawd-cloud-os",
    "envFilePrecedence": [
      "clawd-cloud-os/.env",
      ".env",
      "solana-clawd/.env"
    ]
  },
  "services": [
    {
      "id": "solanaos-server",
      "name": "SolanaOS Control UI",
      "portEnv": "SOLANAOS_UI_PORT",
      "defaultPort": 7777,
      "command": "solanaos server",
      "healthUrl": "http://127.0.0.1:7777"
    },
    {
      "id": "solanaos-daemon",
      "name": "SolanaOS daemon / gateway",
      "portEnv": "SOLANAOS_DAEMON_PORT",
      "defaultPort": 18790,
      "command": "solanaos daemon",
      "healthUrl": "http://127.0.0.1:18790"
    },
    {
      "id": "solana-clawd-mcp",
      "name": "solana-clawd MCP HTTP",
      "portEnv": "CLAWD_MCP_PORT",
      "defaultPort": 3000,
      "command": "npm run mcp:http",
      "healthUrl": "http://127.0.0.1:3000/mcp"
    }
  ],
  "remote": {
    "api": "https://solanaclawd.com/api",
    "websocket": "wss://solanaclawd.com/ws",
    "dashboard": "https://solanaclawd.com"
  },
  "security": {
    "defaultTradePermission": "ask",
    "defaultSignPermission": "deny",
    "defaultSpendPermission": "deny",
    "registrationRequiresExplicitWallet": true
  }
}
